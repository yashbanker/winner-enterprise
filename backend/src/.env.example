# ====================================
# WINNER ENTERPRISE - Backend Env Vars
# ====================================
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/winner_enterprise
# For MongoDB Atlas, use:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/winner_enterprise

# JWT
JWT_SECRET=replace_this_with_a_very_long_random_string
JWT_EXPIRE=7d

# Admin Seed Credentials (used by `npm run seed`)
ADMIN_EMAIL=admin@winnerenterprise.com
ADMIN_PASSWORD=Winner@2026
ADMIN_NAME=Winner Admin

# Cloudinary (optional — falls back to local /uploads when blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS Origin (frontend URL)
CLIENT_URL=http://localhost:5173

# Mail (optional, for inquiry notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WINNER ENTERPRISE <noreply@winnerenterprise.com>"
MAIL_TO=hiren@winnerenterprise.com
